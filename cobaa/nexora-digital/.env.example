# ==================NEXORA DIGITAL — ENVIRONMENT==================
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# MySQL — ganti kredensial sesuai server Anda
DATABASE_URL="mysql://root:password@localhost:3306/nexora"

# URL frontend (untuk CORS)
FRONTEND_URL=http://localhost:5173

# Secret — WAJIB diganti dengan nilai acak yang panjang (jangan commit nilai asli!)
JWT_SECRET=rahasia_jwt_anda_yang_sangat_panjang_dan_acak_123
SESSION_SECRET=rahasia_session_anda_yang_sangat_panjang_dan_acak_456

# Midtrans (https://docs.midtrans.com) — gunakan Sandbox keys dari MAP/Merchant Portal
MIDTRANS_SERVER_KEY=SB-Mid-server-isinya_di_sini
MIDTRANS_CLIENT_KEY=SB-Mid-client-isinya_di_sini
MIDTRANS_IS_PRODUCTION=false

# Sosmedmedia (https://sosmedmedia.com/api-docs)
SOSMEDMEDIA_API_KEY=isinya_api_key_sosmedmedia_di_sini
SOSMEDMEDIA_API_BASE_URL=https://sosmedmedia.com/api/v2

# Digiflazz (https://developer.digiflazz.com)
DIGIFLAZZ_USERNAME=wubigogwm0LD
DIGIFLAZZ_API_KEY=dev-74e8cee0-d465-11f1-ac61-e518b55fc3fd
DIGIFLAZZ_BASE_URL=https://member.digiflazz.com/buyer-area/connection/api
# set true hanya saat testing transaksi digiflazz (testing flag), jangan di production
DIGIFLAZZ_TESTING=false

# Redis (opsional; worker saat ini berjalan dengan polling DB)
REDIS_URL=

# Seed development SAJA — jangan dipakai di production
ADMIN_SEED_EMAIL=admin@nexora.test
ADMIN_SEED_PASSWORD=ChangeMe_Now!2026

# Worker
WORKER_POLL_MS=5000