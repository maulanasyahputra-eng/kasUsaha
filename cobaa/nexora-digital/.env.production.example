NODE_ENV=production
PORT=5000
LOG_LEVEL=info

# MySQL production — user aplikasi dengan privilege minimal (bukan root!)
DATABASE_URL="mysql://nexora:GANTI_PASSWORD@localhost:3306/nexora"

# Domain publik (CORS whitelist) — tanpa localhost
FRONTEND_URL=https://domainanda.com

# Secret WAJIB diganti, minimal 64 karakter acak (openssl rand -hex 32)
JWT_SECRET=GANTI_DENGAN_RANDOM_64CHAR
SESSION_SECRET=GANTI_DENGAN_RANDOM_64CHAR

# Midtrans — dari dashboard.midtrans.com SETELAH merchant terverifikasi
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=true

# Sosmedmedia — credential asli pemilik
SOSMEDMEDIA_API_KEY=
SOSMEDMEDIA_API_BASE_URL=

# Digiflazz — credential asli pemilik
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_API_KEY=
DIGIFLAZZ_BASE_URL=
DIGIFLAZZ_TESTING=false

REDIS_URL=

WORKER_POLL_MS=5000
