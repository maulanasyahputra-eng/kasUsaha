<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Selamat datang 👋"
                    android:textColor="#64748B"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="KasUsaha"
                    android:textColor="#0F172A"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Kelola keuangan usaha dengan mudah"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- ICON -->
            <TextView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_icon_home"
                android:gravity="center"
                android:text="💼"
                android:textSize="25sp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- CARD SALDO -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="185dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_saldo"
            android:elevation="7dp"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOTAL SALDO"
                android:textColor="#BFDBFE"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSaldo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Rp 0"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="15dp"
                android:background="#55FFFFFF" />

            <TextView
                android:id="@+id/tvStatusSaldo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="✓ Keuangan Anda terpantau"
                android:textColor="#DBEAFE"
                android:textSize="13sp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- RINGKASAN -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Ringkasan Keuangan"
            android:textColor="#0F172A"
            android:textSize="19sp"
            android:textStyle="bold" />


        <!-- ================================================= -->
        <!-- CARD RINGKASAN -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:orientation="horizontal">

            <!-- PEMASUKAN -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="125dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_card_pemasukan"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_icon_pemasukan"
                    android:gravity="center"
                    android:text="↗"
                    android:textColor="#16A34A"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="Pemasukan"
                    android:textColor="#64748B"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvPemasukan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Rp 0"
                    android:textColor="#15803D"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- PENGELUARAN -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="125dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_card_pengeluaran"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_icon_pengeluaran"
                    android:gravity="center"
                    android:text="↘"
                    android:textColor="#DC2626"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="Pengeluaran"
                    android:textColor="#64748B"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvPengeluaran"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Rp 0"
                    android:textColor="#DC2626"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- MENU TRANSAKSI -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Kelola Transaksi"
            android:textColor="#0F172A"
            android:textSize="19sp"
            android:textStyle="bold" />


        <!-- ================================================= -->
        <!-- BUTTON PEMASUKAN -->
        <!-- ================================================= -->

        <Button
            android:id="@+id/btnPemasukan"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="13dp"
            android:background="@drawable/bg_button"
            android:backgroundTint="@null"
            android:minHeight="0dp"
            android:text="+   Tambah Pemasukan"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />


        <!-- ================================================= -->
        <!-- BUTTON PENGELUARAN -->
        <!-- ================================================= -->

        <Button
            android:id="@+id/btnPengeluaran"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_button_pengeluaran"
            android:backgroundTint="@null"
            android:minHeight="0dp"
            android:text="-   Tambah Pengeluaran"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />


        <!-- ================================================= -->
        <!-- BUTTON RIWAYAT -->
        <!-- ================================================= -->

        <Button
            android:id="@+id/btnRiwayat"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_button_riwayat"
            android:backgroundTint="@null"
            android:minHeight="0dp"
            android:text="☷   Riwayat Transaksi"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />


        <!-- ================================================= -->
        <!-- INFO CARD -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_info_home"
            android:orientation="horizontal"
            android:padding="15dp">

            <TextView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:gravity="center"
                android:text="💡"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tips KasUsaha"
                    android:textColor="#0F172A"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Catat setiap pemasukan dan pengeluaran agar kondisi keuangan usaha selalu terpantau."
                    android:textColor="#64748B"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- FOOTER -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="KasUsaha  •  Kelola uang lebih teratur"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>