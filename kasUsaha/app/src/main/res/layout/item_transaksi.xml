<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card"
    android:elevation="3dp"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- ============================================== -->
    <!-- BARIS UTAMA -->
    <!-- ============================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- ICON TRANSAKSI -->

        <TextView
            android:id="@+id/tvIcon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_icon_transaksi"
            android:gravity="center"
            android:text="↗"
            android:textColor="#16A34A"
            android:textSize="21sp"
            android:textStyle="bold" />


        <!-- INFORMASI TRANSAKSI -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvJenis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pemasukan"
                android:textColor="#0F172A"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvKategori"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Penjualan"
                android:textColor="#64748B"
                android:textSize="12sp" />

        </LinearLayout>


        <!-- NOMINAL -->

        <TextView
            android:id="@+id/tvNominal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="+ Rp 50.000"
            android:textColor="#16A34A"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>


    <!-- ============================================== -->
    <!-- GARIS PEMBATAS -->
    <!-- ============================================== -->

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="13dp"
        android:background="#F1F5F9" />


    <!-- ============================================== -->
    <!-- KETERANGAN -->
    <!-- ============================================== -->

    <TextView
        android:id="@+id/tvKeterangan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:maxLines="2"
        android:text="Penjualan produk hari ini"
        android:textColor="#475569"
        android:textSize="13sp" />


    <!-- ============================================== -->
    <!-- FOOTER -->
    <!-- ============================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- TANGGAL -->

        <TextView
            android:id="@+id/tvTanggal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="25/08/2026"
            android:textColor="#94A3B8"
            android:textSize="11sp" />


        <!-- ========================================== -->
        <!-- TOMBOL HAPUS -->
        <!-- ========================================== -->

        <Button
            android:id="@+id/btnHapus"
            android:layout_width="75dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_button_hapus"
            android:backgroundTint="@null"
            android:buttonTint="@null"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="Hapus"
            android:textAllCaps="false"
            android:textColor="#a4c639"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>