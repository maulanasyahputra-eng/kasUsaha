<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- ================================================= -->
    <!-- ISI UTAMA -->
    <!-- ================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#F8FAFC">

        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingTop="18dp"
            android:paddingRight="20dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Riwayat Transaksi"
                android:textColor="#0F172A"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Pantau seluruh aktivitas keuangan usaha"
                android:textColor="#64748B"
                android:textSize="13sp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- SCROLL CONTENT -->
        <!-- ================================================= -->

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="18dp"
                android:paddingTop="12dp"
                android:paddingRight="18dp"
                android:paddingBottom="90dp">


                <!-- ================================================= -->
                <!-- RINGKASAN -->
                <!-- ================================================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ringkasan Keuangan"
                    android:textColor="#0F172A"
                    android:textSize="19sp"
                    android:textStyle="bold" />


                <!-- ================================================= -->
                <!-- CARD RINGKASAN -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">


                    <!-- PEMASUKAN -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="118dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:background="@drawable/bg_card_pemasukan"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_icon_pemasukan"
                            android:gravity="center"
                            android:text="↗"
                            android:textColor="#16A34A"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="Pemasukan"
                            android:textColor="#166534"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTotalPemasukan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Rp 0"
                            android:textColor="#15803D"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>


                    <!-- PENGELUARAN -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="118dp"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="5dp"
                        android:background="@drawable/bg_card_pengeluaran"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_icon_pengeluaran"
                            android:gravity="center"
                            android:text="↘"
                            android:textColor="#EF4444"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="Pengeluaran"
                            android:textColor="#991B1B"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTotalPengeluaran"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Rp 0"
                            android:textColor="#DC2626"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>


                    <!-- SALDO -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="118dp"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/bg_card_saldo"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_icon_saldo"
                            android:gravity="center"
                            android:text="Rp"
                            android:textColor="#2563EB"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="Saldo"
                            android:textColor="#1E40AF"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSaldoRiwayat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Rp 0"
                            android:textColor="#1D4ED8"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>


                <!-- ================================================= -->
                <!-- SEMUA TRANSAKSI -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Semua Transaksi"
                            android:textColor="#0F172A"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Daftar aktivitas keuangan Anda"
                            android:textColor="#94A3B8"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_icon_riwayat"
                        android:gravity="center"
                        android:text="☷"
                        android:textColor="#2563EB"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- ================================================= -->
                <!-- DATA KOSONG -->
                <!-- ================================================= -->

                <LinearLayout
                    android:id="@+id/layoutDataKosong"
                    android:layout_width="match_parent"
                    android:layout_height="210dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_empty"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:background="@drawable/bg_empty_icon"
                        android:gravity="center"
                        android:text="📋"
                        android:textSize="28sp" />

                    <TextView
                        android:id="@+id/tvTidakAdaData"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:text="Belum ada transaksi"
                        android:textColor="#334155"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:gravity="center"
                        android:text="Tambahkan pemasukan atau pengeluaran"
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />

                </LinearLayout>


                <!-- ================================================= -->
                <!-- LIST TRANSAKSI -->
                <!-- ================================================= -->

                <ListView
                    android:id="@+id/listRiwayat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:divider="@android:color/transparent"
                    android:dividerHeight="10dp"
                    android:nestedScrollingEnabled="false" />


                <!-- ================================================= -->
                <!-- FOOTER -->
                <!-- ================================================= -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center"
                    android:text="KasUsaha  •  Riwayat keuangan"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />

            </LinearLayout>

        </ScrollView>

    </LinearLayout>


    <!-- ================================================= -->
    <!-- TOMBOL KEMBALI -->
    <!-- ================================================= -->

    <Button
        android:id="@+id/btnKembali"
        android:layout_width="105dp"
        android:layout_height="44dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_button_back"
        android:backgroundTint="@null"
        android:elevation="8dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="←  Kembali"
        android:textAllCaps="false"
        android:textColor="#a4c639"
        android:textSize="13sp"
        android:textStyle="bold" />

</FrameLayout>