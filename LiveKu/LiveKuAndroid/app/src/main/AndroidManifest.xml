<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- INTERNET -->
    <uses-permission
        android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="LiveKu"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LiveKu"
        android:usesCleartextTraffic="true">

        <!-- LOGIN / REGISTER -->
        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>

                <action
                    android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LAUNCHER" />

            </intent-filter>

        </activity>

        <!-- HOME -->
        <activity
            android:name=".HomeActivity"
            android:exported="false" />

        <!-- WALLET -->
        <activity
            android:name=".WalletActivity"
            android:exported="false" />

        <!-- PROFILE -->
        <activity
            android:name=".ProfileActivity"
            android:exported="false" />

        <!-- DEPOSIT (TAMBAHKAN INI) -->
        <activity
            android:name=".DepositActivity"
            android:exported="false" />

        <!-- WITHDRAW (TAMBAHKAN INI - sesuaikan jika nama file class-nya berbeda, misal WithdrawActivity) -->
        <activity
            android:name=".WithdrawActivity"
            android:exported="false" />

    </application>

</manifest>